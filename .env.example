# Backend config for the scan pipeline. Copy to .env and fill in.
# Any OpenAI-compatible endpoint works (LM Studio, Ollama, vLLM, OpenWebUI, OpenRouter).
#
#   cp .env.example .env
#
# The scripts read these two. The SDK posts to ${LM_BASE_URL}/chat/completions.
LM_BASE_URL=http://localhost:1234/v1
LM_API_KEY=lm-studio

# OpenWebUI users may instead set these; the scripts derive
# LM_BASE_URL=${OPENWEBUI_URL}/api and LM_API_KEY=${OPENWEBUI_API_KEY}.
# OPENWEBUI_URL=https://your-openwebui.example.com
# OPENWEBUI_API_KEY=sk-...
